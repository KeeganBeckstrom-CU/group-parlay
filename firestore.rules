rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A device "owns" a profile if it created it, or picked it with "Already in the crew? Pick your name".
    function linkedTo(pid) {
      return exists(/databases/$(database)/documents/links/$(request.auth.uid))
        && get(/databases/$(database)/documents/links/$(request.auth.uid)).data.pid == pid;
    }
    function owns(pid) {
      return request.auth != null && (request.auth.uid == pid || linkedTo(pid));
    }

    // Profiles and picks: everyone reads, only the owner's devices write.
    match /votes/{pid} {
      allow read: if true;
      allow create, update: if owns(pid)
        && request.resource.data.keys().hasOnly(['name', 'hooper', 'picks', 'updatedAt', 'joinedAt', 'hasPin'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && (!('hooper' in request.resource.data) || (request.resource.data.hooper is string && request.resource.data.hooper.size() <= 32));
      allow delete: if owns(pid);
    }

    // Which profile each device uses. A device can point itself at any existing profile.
    match /links/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pid', 'at'])
        && exists(/databases/$(database)/documents/votes/$(request.resource.data.pid));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Games and scores come from games.json on the website, not the database.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
